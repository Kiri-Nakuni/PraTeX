+/// be represented by the linked platform ABI.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[non_exhaustive]
+pub enum PathError {
+  /// This build did not link `libkpathsea`.
+  InProcessUnavailable,
+  /// A program or logical filename contains an interior NUL byte.
