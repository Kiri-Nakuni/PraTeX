+//! Unix exact-byte and unindexed-file lookup regression.
+#![cfg(all(kpathsea_linked, unix))]
+
+use kpathsea::{Kpaths, formats};
+use std::ffi::{OsStr, OsString};
+use std::os::unix::ffi::{OsStrExt, OsStringExt};
+
+struct TexinputsGuard(Option<OsString>);
+
+impl Drop for TexinputsGuard {
+  fn drop(&mut self) {
+    // SAFETY: this integration binary contains one test, so no peer test can
+    // read or mutate TEXINPUTS concurrently.
+    unsafe {
+      match self.0.take() {
+        Some(value) => std::env::set_var("TEXINPUTS", value),
+        None => std::env::remove_var("TEXINPUTS"),
+      }
+    }
+  }
+}
+
+#[test]
+fn unindexed_file_in_non_utf8_directory_round_trips_exactly() {
+  let unique = format!(
+    "kpathsea-exact-{}-{}",
+    std::process::id(),
+    std::time::SystemTime::now()
+      .duration_since(std::time::UNIX_EPOCH)
+      .unwrap()
+      .as_nanos()
+  );
+  let mut component = unique.into_bytes();
+  component.push(0xff);
+  let directory = std::env::temp_dir().join(OsString::from_vec(component));
+  std::fs::create_dir(&directory).unwrap();
+  let filename = OsStr::new("pratex-unindexed-exact.tex");
+  let expected = directory.join(filename);
+  std::fs::write(&expected, b"exact path fixture\n").unwrap();
+
+  let previous = std::env::var_os("TEXINPUTS");
+  let _guard = TexinputsGuard(previous);
+  // SAFETY: this integration binary contains one test.
+  unsafe { std::env::set_var("TEXINPUTS", directory.as_os_str()) };
+
+  let kpse = Kpaths::new_in_process_with_program_name("pratex").unwrap();
+  // Exercise both boolean values against a file absent from every ls-R. The
+  // false result is distribution-policy-dependent; the true result must do
+  // the filesystem check and find the file.
+  let _unchecked = kpse
+    .find_file_path_with_format(filename, formats::TEX, false)
+    .expect("Unix logical names are arbitrary non-NUL bytes");
+  let found = kpse
+    .find_file_path_with_format(filename, formats::TEX, true)
+    .expect("Unix physical paths are arbitrary non-NUL bytes")
+    .expect("must_exist=true must find the unindexed local file");
+  assert_eq!(
+    found.as_os_str().as_bytes(),
+    expected.as_os_str().as_bytes()
+  );
+
+  drop(kpse);
+  std::fs::remove_file(&expected).unwrap();
+  std::fs::remove_dir(&directory).unwrap();
+}
