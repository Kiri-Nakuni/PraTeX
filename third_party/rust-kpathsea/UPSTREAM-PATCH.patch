+//! Linked-only ownership and exact-path regression tests.
+#![cfg(kpathsea_linked)]
+
+use kpathsea::{Kpaths, PathError, formats};
+use std::ffi::OsStr;
+use std::sync::Mutex;
+
+static LINKED_TEST_LOCK: Mutex<()> = Mutex::new(());
+
+#[test]
+fn explicit_program_name_rejects_interior_nul() {
+  let error = match Kpaths::new_in_process_with_program_name("pra\0tex") {
+    Ok(_) => panic!("an interior-NUL program name must be rejected"),
+    Err(error) => error,
+  };
+  assert_eq!(error, PathError::InteriorNul);
+
+  #[cfg(unix)]
+  {
+  let _guard = LINKED_TEST_LOCK.lock().unwrap();
+  let kpse = Kpaths::new_in_process_with_program_name("pratex")
+    .expect("linked test needs an initialized libkpathsea");
+  assert_eq!(
+    kpse.find_file_path_with_format(OsStr::new("bad\0name.tex"), formats::TEX, true),
+    Err(PathError::InteriorNul)
+  );
+  }
+}
+
+#[cfg(unix)]
+#[test]
+fn repeated_successful_lookup_releases_every_owned_result() {
+  let _guard = LINKED_TEST_LOCK.lock().unwrap();
+  let kpse = Kpaths::new_in_process_with_program_name("pratex")
+    .expect("linked test needs an initialized libkpathsea");
+  for _ in 0..4096 {
+    let path = kpse
+      .find_file_path_with_format(OsStr::new("plain.tex"), formats::TEX, true)
+      .expect("plain.tex path must be representable")
+      .expect("linked TeX installation must contain plain.tex");
+    assert!(path.ends_with("plain.tex"));
+  }
+}
+
+#[cfg(windows)]
+#[test]
+fn windows_exact_lookup_falls_back_before_a_dll_allocation() {
+  let _guard = LINKED_TEST_LOCK.lock().unwrap();
+  let kpse = Kpaths::new_in_process_with_program_name("pratex")
+    .expect("linked Windows test needs TeX Live's kpathsea DLL");
+  assert_eq!(
+    kpse.find_file_path_with_format(OsStr::new("plain.tex"), formats::TEX, true),
+    Err(PathError::UnsupportedPathEncoding)
+  );
+}
