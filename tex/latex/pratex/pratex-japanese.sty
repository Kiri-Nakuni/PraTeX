\NeedsTeXFormat{LaTeX2e}[2023-11-01]
\ProvidesPackage{pratex-japanese}
  [2026/08/24 v0.4 PraTeX-native Japanese NFSS bridge]

\ifdefined\pratexversion\else
  \PackageError{pratex-japanese}
    {PraTeX identity primitive \string\pratexversion\space is missing}
    {Run this package with PraTeX.  Do not define another engine's version
     primitive or a local stand-in for \string\pratexversion.}
  \expandafter\endinput
\fi
\ifdefined\pratexjfont\else
  \PackageError{pratex-japanese}
    {PraTeX Japanese font primitive \string\pratexjfont\space is missing}
    {Use a PraTeX build with horizontal JFM support.}
  \expandafter\endinput
\fi

% Japanese font selection has four NFSS-like attributes of its own.  PJY1 is
% a PraTeX package contract, not a claim to implement a pLaTeX encoding.  The
% public setters are deliberately separate from the engine's \pratexjfont
% primitive: like \fontfamily and friends, they only change the request.
\def\pratex@jencoding{PJY1}
\def\pratex@jfamily{mc}
\def\pratex@jseries{m}
\def\pratex@jshape{n}
\def\pratexjfontencoding#1{\edef\pratex@jencoding{#1}}
\def\pratexjfontfamily#1{\edef\pratex@jfamily{#1}}
\def\pratexjfontseries#1{\edef\pratex@jseries{#1}}
\def\pratexjfontshape#1{\edef\pratex@jshape{#1}}

% A declaration maps an exact Japanese attribute tuple to one horizontal JFM
% basename.  Size functions and substitution rules are intentionally outside
% this first slice; an absent exact tuple is therefore a typed package error.
\def\DeclarePraTeXJapaneseFontShape#1#2#3#4#5{%
  \expandafter\gdef
    \csname pratex@jshape@#1/#2/#3/#4\endcsname{#5}}

\DeclarePraTeXJapaneseFontShape{PJY1}{mc}{m}{n}{upjisr-h}

% Preserve the original 10pt selector as a stable public baseline.  The
% general selector below shares it through a metric-name + exact-sp cache key,
% so 10, 10.0, and equivalent dimension expressions use one font slot.
\pratexjfont\pratexdefaultjapanesefont=upjisr-h at 10pt
\pratexdefaultjapanesefont
\edef\pratex@jfontsizekey{\number\dimexpr10pt\relax}
\expandafter\global\expandafter\let
  \csname pratex@jfont/upjisr-h/\pratex@jfontsizekey\endcsname
  \pratexdefaultjapanesefont

\def\pratexselectjapanesefont{%
  \edef\pratex@jshapekey{%
    pratex@jshape@\pratex@jencoding/\pratex@jfamily/%
    \pratex@jseries/\pratex@jshape}%
  \ifcsname\pratex@jshapekey\endcsname
    \edef\pratex@jmetric{\csname\pratex@jshapekey\endcsname}%
    \edef\pratex@jfontsizekey{\number\dimexpr\f@size pt\relax}%
    \edef\pratex@jfontkey{%
      pratex@jfont/\pratex@jmetric/\pratex@jfontsizekey}%
    \ifcsname\pratex@jfontkey\endcsname
    \else
      \expandafter\global\expandafter\pratexjfont
        \csname\pratex@jfontkey\endcsname
        =\pratex@jmetric\space at \dimexpr\f@size pt\relax
    \fi
    \csname\pratex@jfontkey\endcsname
  \else
    \PackageError{pratex-japanese}
      {Japanese font shape
       \pratex@jencoding/\pratex@jfamily/\pratex@jseries/\pratex@jshape
       \space is not declared}
      {Declare the exact tuple with
       \string\DeclarePraTeXJapaneseFontShape.}%
  \fi}

\def\pratexselectdefaultjapanesefont{%
  \pratexjfontencoding{PJY1}%
  \pratexjfontfamily{mc}%
  \pratexjfontseries{m}%
  \pratexjfontshape{n}%
  \pratexselectjapanesefont}

\def\pratexusejapanesefont#1#2#3#4{%
  \pratexjfontencoding{#1}%
  \pratexjfontfamily{#2}%
  \pratexjfontseries{#3}%
  \pratexjfontshape{#4}%
  \selectfont}

% A relation declaration maps the current Japanese tuple to a Latin NFSS
% request.  The declaration form is global, while the Set form follows the
% current TeX group.  An empty Japanese shape installs a wildcard; just as in
% the documented pLaTeX relation model, that form preserves the Latin shape
% requested at the moment \selectfont runs instead of imposing argument 8.
\def\pratex@declarerelation#1#2#3#4#5#6#7#8#9{%
  \def\pratex@relationsourceshape{#5}%
  \ifx\pratex@relationsourceshape\@empty
    #1\expandafter\def
      \csname pratex@relation@wild@#2/#3/#4\endcsname{%
        \fontencoding{#6}\fontfamily{#7}\fontseriesforce{#8}}%
  \else
    #1\expandafter\def
      \csname pratex@relation@exact@#2/#3/#4/#5\endcsname{%
        \fontencoding{#6}\fontfamily{#7}%
        \fontseriesforce{#8}\fontshapeforce{#9}}%
  \fi}

\def\DeclarePraTeXRelationFont#1#2#3#4#5#6#7#8{%
  \pratex@declarerelation\global
    {#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}}
\def\SetPraTeXRelationFont#1#2#3#4#5#6#7#8{%
  \pratex@declarerelation\relax
    {#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}}

% Relation use is an explicit one-shot request.  Resolve the public document-
% body form in the generic before-hook so the ordinary NFSS \selectfont sees
% all four Latin attributes together.  The consume is global: a request made
% outside a nested group cannot revive when that group ends.
\def\pratex@relationpending{0}
\protected\def\UsePraTeXRelationFont{\def\pratex@relationpending{1}}
\def\pratex@applyrelation{%
  \ifnum\pratex@relationpending=1\relax
    \global\def\pratex@relationpending{0}%
    \edef\pratex@relationkey{%
      pratex@relation@exact@\pratex@jencoding/\pratex@jfamily/%
      \pratex@jseries/\pratex@jshape}%
    \edef\pratex@relationallkey{%
      pratex@relation@wild@\pratex@jencoding/\pratex@jfamily/%
      \pratex@jseries}%
    \ifcsname\pratex@relationkey\endcsname
      \csname\pratex@relationkey\endcsname
    \else
      \ifcsname\pratex@relationallkey\endcsname
        \csname\pratex@relationallkey\endcsname
      \else
        \PackageError{pratex-japanese}
          {No relation font for
           \pratex@jencoding/\pratex@jfamily/%
           \pratex@jseries/\pratex@jshape}
          {Declare an exact or shape-wildcard mapping with
           \string\DeclarePraTeXRelationFont.}%
      \fi
    \fi
  \fi}

\AddToHook{cmd/selectfont/before}{\pratex@applyrelation}

% A PraTeX-native class may own its document-start adapter.  General classes
% get the same selector through the public LaTeX hook without engine spoofing.
\ifdefined\pratexsetjapanesefonthook
  \pratexsetjapanesefonthook{\pratexselectjapanesefont}
\else
  \AtBeginDocument{\pratexselectjapanesefont}
\fi
\AddToHook{selectfont}{%
  \ifdefined\pratexjapanesefonthook
    \pratexjapanesefonthook
  \else
    \pratexselectjapanesefont
  \fi}

\endinput
